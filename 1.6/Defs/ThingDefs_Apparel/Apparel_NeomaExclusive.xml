<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ─── Exclusive apparel for the Neoma Ring companion.
       All three pieces carry NeomaExclusiveExtension — the Harmony patch
       Patch_NeomaRingWearBlock will reject equip attempts from non-Neoma pawns. ─── -->

  <ThingDef ParentName="ApparelBase">
    <defName>Apparel_NeomaSynthsuit</defName>
    <label>Neoma synthsuit</label>
    <description>A seamless exo-suit synthesized from Apex Crystal lattice and archotech alloy. The material adapts in real time to incoming kinetic and thermal threats, and its embedded vacuum membrane makes deep space exposure trivial. Biometrically keyed to Neoma.</description>
    <thingClass>Apparel</thingClass>
    <category>Item</category>
    <techLevel>Archotech</techLevel>
    <graphicData>
      <texPath>Things/Pawn/Humanlike/Apparel/PowerArmor/PowerArmor</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <MaxHitPoints>500</MaxHitPoints>
      <Mass>3</Mass>
      <Flammability>0</Flammability>
      <ArmorRating_Sharp>1.15</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.55</ArmorRating_Blunt>
      <ArmorRating_Heat>0.65</ArmorRating_Heat>
      <Insulation_Cold>120</Insulation_Cold>
      <Insulation_Heat>20</Insulation_Heat>
      <EquipDelay>2</EquipDelay>
      <MarketValue>6000</MarketValue>
    </statBases>
    <equippedStatOffsets>
      <MoveSpeed>0.3</MoveSpeed>
      <ToxicEnvironmentResistance>0.8</ToxicEnvironmentResistance>
    </equippedStatOffsets>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Legs</li>
      </bodyPartGroups>
      <layers>
        <li>Middle</li>
      </layers>
      <tags>
        <li>Soldier</li>
      </tags>
    </apparel>
    <generateCommonality>0</generateCommonality>
    <smeltable>false</smeltable>
    <tradeability>None</tradeability>
    <thingCategories>
      <li>Apparel</li>
    </thingCategories>
    <modExtensions>
      <li Class="SyntheraCore.NeomaExclusiveExtension"/>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="ApparelBase">
    <defName>Apparel_NeomaCrown</defName>
    <label>Neoma crown</label>
    <description>A neural amplifier crown grown from pure Apex Crystal filaments. It extends Neoma's cognitive broadcast radius, enhances her psychic sensitivity to a near-prescient level, and suppresses emotional noise that might destabilize her coherence matrix. Biometrically keyed to Neoma.</description>
    <thingClass>Apparel</thingClass>
    <category>Item</category>
    <techLevel>Archotech</techLevel>
    <graphicData>
      <texPath>Things/Pawn/Humanlike/Apparel/PowerArmorHelmet/PowerArmorHelmet</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <Mass>0.5</Mass>
      <Flammability>0</Flammability>
      <ArmorRating_Sharp>0.90</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.45</ArmorRating_Blunt>
      <ArmorRating_Heat>0.50</ArmorRating_Heat>
      <Insulation_Cold>30</Insulation_Cold>
      <Insulation_Heat>5</Insulation_Heat>
      <EquipDelay>1</EquipDelay>
      <MarketValue>4000</MarketValue>
    </statBases>
    <equippedStatOffsets>
      <PsychicSensitivity>0.5</PsychicSensitivity>
      <MentalBreakThreshold>-0.15</MentalBreakThreshold>
    </equippedStatOffsets>
    <apparel>
      <bodyPartGroups>
        <li>FullHead</li>
        <li>UpperHead</li>
      </bodyPartGroups>
      <layers>
        <li>Shell</li>
      </layers>
      <tags>
        <li>Soldier</li>
      </tags>
    </apparel>
    <generateCommonality>0</generateCommonality>
    <smeltable>false</smeltable>
    <tradeability>None</tradeability>
    <thingCategories>
      <li>Apparel</li>
    </thingCategories>
    <modExtensions>
      <li Class="SyntheraCore.NeomaExclusiveExtension"/>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="ApparelBase">
    <defName>Apparel_NeomaCloak</defName>
    <label>Neoma mantle</label>
    <description>A reactive outer mantle woven from Apex resonance fibres. It shimmers faintly at rest and flares brilliant white when deflecting kinetic impacts. Its social-resonance emitters amplify Neoma's projected presence, making every word she speaks feel like a command from a higher order. Biometrically keyed to Neoma.</description>
    <thingClass>Apparel</thingClass>
    <category>Item</category>
    <techLevel>Archotech</techLevel>
    <graphicData>
      <texPath>Things/Pawn/Humanlike/Apparel/Duster/Duster</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <MaxHitPoints>250</MaxHitPoints>
      <Mass>1</Mass>
      <Flammability>0</Flammability>
      <ArmorRating_Sharp>0.45</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.20</ArmorRating_Blunt>
      <ArmorRating_Heat>0.30</ArmorRating_Heat>
      <Insulation_Cold>15</Insulation_Cold>
      <Insulation_Heat>8</Insulation_Heat>
      <EquipDelay>1</EquipDelay>
      <MarketValue>3500</MarketValue>
    </statBases>
    <equippedStatOffsets>
      <SocialImpact>0.2</SocialImpact>
      <MeleeDodgeChance>0.15</MeleeDodgeChance>
    </equippedStatOffsets>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
      </bodyPartGroups>
      <layers>
        <li>Shell</li>
      </layers>
      <tags>
        <li>Soldier</li>
      </tags>
    </apparel>
    <generateCommonality>0</generateCommonality>
    <smeltable>false</smeltable>
    <tradeability>None</tradeability>
    <thingCategories>
      <li>Apparel</li>
    </thingCategories>
    <modExtensions>
      <li Class="SyntheraCore.NeomaExclusiveExtension"/>
    </modExtensions>
  </ThingDef>

</Defs>
