<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Roupa da Hatsune Miku -->
  <ThingDef ParentName="ApparelBase">
    <defName>MikuHatsuneOutfit</defName>
    <label>Hatsune's outfit</label>
    <description>The iconic stage outfit of the Virtual Diva — a teal and black ensemble broadcast across star systems for generations. It is somehow both ancient and timeless.</description>
    <thingClass>Apparel</thingClass>
    <category>Item</category>
    <graphicData>
      <texPath>Things/Pawn/SynthMiku/Clouth/Hatsune_Cloth_south</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <altitudeLayer>Item</altitudeLayer>
    <useHitPoints>true</useHitPoints>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <Mass>0.5</Mass>
      <MarketValue>5000</MarketValue>
      <Flammability>0</Flammability>
    </statBases>
    <generateCommonality>0</generateCommonality>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Legs</li>
      </bodyPartGroups>
      <layers>
        <li>Middle</li>
      </layers>
      <wornGraphicPath>Things/Pawn/SynthMiku/Clouth/Hatsune_Cloth</wornGraphicPath>
    </apparel>
    <smeltable>false</smeltable>
  </ThingDef>

  <!-- Anel de Neoma -->
  <ThingDef ParentName="ApparelBase">
    <defName>NeomaRing</defName>
    <label>SyntheraCore_NeomaRing_Label</label>
    <description>SyntheraCore_NeomaRing_Description</description>
    <thingClass>Apparel</thingClass>
    <category>Item</category>
    <graphicData>
      <!-- Placeholder: replace with Things/Apparel/Neoma/Ring once the art exists -->
      <texPath>Things/Item/Resource/Gold</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <altitudeLayer>Item</altitudeLayer>
    <useHitPoints>true</useHitPoints>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <Mass>0.1</Mass>
      <Bulk>0.1</Bulk>
      <MarketValue>10000</MarketValue>
      <Flammability>0</Flammability>
    </statBases>
    <generateCommonality>0</generateCommonality>
    <apparel>
      <bodyPartGroups>
        <li>Hands</li>
      </bodyPartGroups>
      <layers>
        <li>OnSkin</li>
      </layers>
      <tags>
        <li>Ring</li>
      </tags>
      <defaultOutfitTags>
        <li>Soldier</li>
      </defaultOutfitTags>
    </apparel>
    <comps>
      <li Class="SyntheraCore.CompProperties_NeomaRing">
        <pawnKind>NeomaPawn</pawnKind>
      </li>
    </comps>
    <thingCategories>
      <li>Apparel</li>
    </thingCategories>
    <smeltable>false</smeltable>
    <tradeTags>
      <li>Exotic</li>
      <li>Artifact</li>
    </tradeTags>
  </ThingDef>

</Defs>