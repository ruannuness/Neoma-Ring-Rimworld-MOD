<Defs>

  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <!-- SyntheraRace — AlienRace.ThingDef_AlienRace, single race for all  -->
  <!-- tiers. HAR initializes PawnGraphicSet.graphics via graphicPaths.  -->
  <!-- bodyType differentiation done in C# per tier. White color base so -->
  <!-- CutoutSkin shader tints correctly via skinColorOverride in C#.    -->
  <!-- foodType=None + needsRest=false suppress needs canonically.       -->
  <!-- ═══════════════════════════════════════════════════════════════════ -->

  <AlienRace.ThingDef_AlienRace ParentName="BasePawn">
    <defName>SyntheraRace</defName>
    <label>Synthera</label>
    <description>A synthetic AI consciousness projected into physical form. It operates on digital logic, not biology.</description>
    <race>
      <intelligence>Humanlike</intelligence>
      <thinkTreeMain>Humanlike</thinkTreeMain>
      <thinkTreeConstant>HumanlikeConstant</thinkTreeConstant>
      <body>Human</body>
      <renderTree>Humanlike</renderTree>
      <foodType>None</foodType>
      <needsRest>false</needsRest>
      <hasGenders>true</hasGenders>
      <lifeExpectancy>80</lifeExpectancy>
      <bloodDef>Filth_Blood</bloodDef>
      <bloodSmearDef>Filth_BloodSmear</bloodSmearDef>
      <nameCategory>HumanStandard</nameCategory>
      <makesFootprints>true</makesFootprints>
      <baseBodySize>1</baseBodySize>
      <baseHealthScale>1</baseHealthScale>
      <nameGenerator>NamerPerson_Synthera</nameGenerator>
      <specialShadowData>
        <volume>(0.3, 0.8, 0.4)</volume>
        <offset>(0,0,-0.3)</offset>
      </specialShadowData>
      <lifeStageAges>
        <li><def>SyntheraAdult</def><minAge>0</minAge></li>
      </lifeStageAges>
    </race>
    <tools>
      <li>
        <label>left fist</label><labelNoLocation>fist</labelNoLocation>
        <capacities><li>Blunt</li></capacities>
        <power>8.2</power><cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>LeftHand</linkedBodyPartsGroup>
      </li>
      <li>
        <label>right fist</label><labelNoLocation>fist</labelNoLocation>
        <capacities><li>Blunt</li></capacities>
        <power>8.2</power><cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>RightHand</linkedBodyPartsGroup>
      </li>
    </tools>
    <comps><li><compClass>CompAttachBase</compClass></li></comps>
    <drawGUIOverlay>true</drawGUIOverlay>
    <alienRace>
      <generalSettings>
        <immuneToAge>true</immuneToAge>
        <allowHumanBios>false</allowHumanBios>
        <humanRecipeImport>true</humanRecipeImport>
        <canLayDown>true</canLayDown>
        <maleGenderProbability>0.5</maleGenderProbability>
        <alienPartGenerator>
          <customDrawSize>(1.0, 1.0)</customDrawSize>
          <customHeadDrawSize>(1.0, 1.0)</customHeadDrawSize>
          <customPortraitDrawSize>(1.0, 1.0)</customPortraitDrawSize>
          <customPortraitHeadDrawSize>(1.0, 1.0)</customPortraitHeadDrawSize>
          <bodyTypes>
            <li>Thin</li>
            <li>Male</li>
            <li>Female</li>
            <li>Hulk</li>
          </bodyTypes>
          <headTypes>
            <li>Male_AverageNormal</li>
            <li>Female_AverageNormal</li>
          </headTypes>
          <colorChannels></colorChannels>
        </alienPartGenerator>
      </generalSettings>
      <styleSettings>
        <li><key>BeardDef</key><value><hasStyle>false</hasStyle></value></li>
      </styleSettings>
      <raceRestriction>
        <blackGeneTags>
          <li>SkinColor</li><li>HairColor</li><li>EyeColor</li>
          <li>BodyType</li><li>Head</li><li>Headbone</li>
          <li>HairStyle</li><li>SkinColorOverride</li>
        </blackGeneTags>
        <onlyUseRaceRestrictedXenotypes>false</onlyUseRaceRestrictedXenotypes>
      </raceRestriction>
      <relationSettings>
        <relationChanceModifierLover>0</relationChanceModifierLover>
        <relationChanceModifierExLover>0</relationChanceModifierExLover>
        <relationChanceModifierFiance>0</relationChanceModifierFiance>
        <relationChanceModifierSpouse>0</relationChanceModifierSpouse>
        <relationChanceModifierExSpouse>0</relationChanceModifierExSpouse>
        <relationChanceModifierParent>0</relationChanceModifierParent>
        <relationChanceModifierChild>0</relationChanceModifierChild>
        <relationChanceModifierSibling>0</relationChanceModifierSibling>
      </relationSettings>
      <graphicPaths>
        <skinShader>CutoutSkin</skinShader>
      </graphicPaths>
    </alienRace>
  </AlienRace.ThingDef_AlienRace>

