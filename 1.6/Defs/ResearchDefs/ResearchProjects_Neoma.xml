  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <!-- NEOMA RING CALIBRATION (X=-2) — left of spine                      -->
  <!-- Unlocks deeper binding protocols for the unique Neoma Ring.        -->
  <!-- ═══════════════════════════════════════════════════════════════════ -->

  <ResearchProjectDef>
    <defName>NeomaRingCalibrationI</defName>
    <label>ring calibration I</label>
    <description>Study the recovered Neoma Ring's internal architecture and develop a calibration protocol. When applied, the ring will establish a backup channel for its bound companion — allowing restoration after death instead of permanent loss of the bond.</description>
    <baseCost>1500</baseCost>
    <techLevel>Spacer</techLevel>
    <tab>NeomaProject</tab>
    <prerequisites>
      <li>NeomaTierII</li>
    </prerequisites>
    <requiredResearchBuilding>HiTechResearchBench</requiredResearchBuilding>
    <researchViewX>-2</researchViewX>
    <researchViewY>1</researchViewY>
  </ResearchProjectDef>

  <ResearchProjectDef>
    <defName>NeomaRingCalibrationII</defName>
    <label>ring calibration II</label>
    <description>Push the ring's resonance matrix to its theoretical maximum. The companion's consciousness can now be fully preserved through death and restored with only temporary disorientation — a complete backup-and-restore loop equivalent to the most advanced altar systems.</description>
    <baseCost>3500</baseCost>
    <techLevel>Ultra</techLevel>
    <tab>NeomaProject</tab>
    <prerequisites>
      <li>NeomaRingCalibrationI</li>
      <li>NeomaTierIII</li>
    </prerequisites>
    <requiredResearchBuilding>HiTechResearchBench</requiredResearchBuilding>
    <researchViewX>-2</researchViewX>
    <researchViewY>2</researchViewY>
  </ResearchProjectDef>

  <!-- ═══════════════════════════════════════════════════════════════════ -->
