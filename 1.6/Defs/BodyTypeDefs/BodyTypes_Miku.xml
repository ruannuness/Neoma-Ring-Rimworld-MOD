<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Custom body type for Hatsune Miku — identical proportions to Female but
       uses the mod's own texture so bodyNakedGraphicPath drives the render. -->
  <BodyTypeDef>
    <defName>MikuBody</defName>
    <label>miku</label>
    <headOffset>(0.10, 0.28)</headOffset>
    <bodyNakedGraphicPath>Things/Pawn/SynthMiku/Body/Naked_Female</bodyNakedGraphicPath>
    <bodyDessicatedGraphicPath>Things/Pawn/Humanlike/Bodies/Dessicated/Dessicated_Thin</bodyDessicatedGraphicPath>
    <bodyGraphicScale>(1, 1)</bodyGraphicScale>
    <woundAnchors>
      <li><rotation>South</rotation><group>Torso</group><offset>(0,0,-0.06)</offset><range>0.2</range></li>
      <li><rotation>South</rotation><tag>LeftLeg</tag><offset>(0.12,0,-0.34)</offset><range>0.125</range></li>
      <li><rotation>South</rotation><tag>RightLeg</tag><offset>(-0.12,0,-0.34)</offset><range>0.125</range></li>
      <li><rotation>South</rotation><tag>LeftShoulder</tag><offset>(0.12,0,0.01)</offset><range>0.125</range></li>
      <li><rotation>South</rotation><tag>RightShoulder</tag><offset>(-0.12,0,0.01)</offset><range>0.125</range></li>
      <li><rotation>South</rotation><group>FullHead</group><offset>(0,0,0)</offset><range>0.18</range><layer>Head</layer></li>
      <li><rotation>South</rotation><tag>RightEye</tag><canMirror>false</canMirror><offset>(-0.095,0,0.18)</offset><range>0</range><layer>Head</layer></li>
      <li><rotation>South</rotation><tag>LeftEye</tag><canMirror>false</canMirror><offset>(0.095,0,0.18)</offset><range>0</range><layer>Head</layer></li>
      <li><rotation>West</rotation><group>FullHead</group><offset>(0,0,0)</offset><range>0.2</range><layer>Head</layer></li>
      <li><rotation>West</rotation><group>Torso</group><offset>(0,0,-0.13)</offset><range>0.2</range></li>
      <li><rotation>West</rotation><tag>LeftShoulder</tag><offset>(-0.05,0,0.1)</offset><range>0.15</range><canMirror>false</canMirror></li>
      <li><rotation>East</rotation><tag>LeftLeg</tag><offset>(-0.05,0,-0.35)</offset><range>0.15</range><canMirror>false</canMirror></li>
      <li><rotation>East</rotation><tag>RightShoulder</tag><offset>(0.05,0,0.1)</offset><range>0.15</range><canMirror>false</canMirror></li>
      <li><rotation>West</rotation><tag>RightLeg</tag><offset>(0.05,0,-0.35)</offset><range>0.15</range><canMirror>false</canMirror></li>
      <li><rotation>East</rotation><tag>RightEye</tag><canMirror>false</canMirror><offset>(0.135,0,0.18)</offset><range>0</range><layer>Head</layer></li>
      <li><rotation>West</rotation><tag>LeftEye</tag><canMirror>false</canMirror><offset>(-0.135,0,0.18)</offset><range>0</range><layer>Head</layer></li>
    </woundAnchors>
    <attachPoints>
      <li><offset>(-.2,0,.05)</offset><type>PlatformRestraint0</type></li>
      <li><offset>(.2,0,.05)</offset><type>PlatformRestraint1</type></li>
      <li><offset>(.2,0,-.5)</offset><type>PlatformRestraint2</type></li>
      <li><offset>(-.2,0,-.5)</offset><type>PlatformRestraint3</type></li>
    </attachPoints>
  </BodyTypeDef>

</Defs>
