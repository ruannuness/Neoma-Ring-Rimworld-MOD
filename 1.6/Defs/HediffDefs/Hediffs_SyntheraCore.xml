<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <HediffDef>
    <defName>SyntheraConsciousness</defName>
    <label>synthera projection</label>
    <description>This consciousness has been projected as a synthera avatar.</description>
    <isBad>false</isBad>
    <stages>
      <li>
        <statFactors>
          <MoveSpeed>1.2</MoveSpeed>
          <WorkSpeedGlobal>1.1</WorkSpeedGlobal>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <!-- Accumulates while the avatar is active. Reset to zero when recalled for maintenance. -->
  <HediffDef>
    <defName>SyntheraSystemStress</defName>
    <label>system stress</label>
    <description>Accumulated operational stress on this synthera's projected systems. Recalling the avatar to its core resets this to zero.</description>
    <isBad>true</isBad>
    <maxSeverity>1.0</maxSeverity>
    <hediffClass>HediffWithComps</hediffClass>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>0.033</severityPerDay>
      </li>
    </comps>
    <stages>
      <li>
        <label>nominal</label>
      </li>
      <li>
        <minSeverity>0.3</minSeverity>
        <label>mild stress</label>
        <statFactors>
          <WorkSpeedGlobal>0.9</WorkSpeedGlobal>
        </statFactors>
      </li>
      <li>
        <minSeverity>0.6</minSeverity>
        <label>high stress</label>
        <statFactors>
          <WorkSpeedGlobal>0.75</WorkSpeedGlobal>
          <MoveSpeed>0.85</MoveSpeed>
        </statFactors>
      </li>
      <li>
        <minSeverity>0.9</minSeverity>
        <label>critical stress</label>
        <statFactors>
          <WorkSpeedGlobal>0.5</WorkSpeedGlobal>
          <MoveSpeed>0.7</MoveSpeed>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <!-- Applied after restoring a hibernating avatar from backup. Fades over 1 in-game day (24h). -->
  <HediffDef>
    <defName>SyntheraHibernationSyndrome</defName>
    <label>hibernation syndrome</label>
    <description>Deep system corruption from emergency hibernation. Cognitive and motor functions are impaired while backup data is reintegrated. Fully clears after 24 hours of active deployment.</description>
    <isBad>true</isBad>
    <maxSeverity>1.0</maxSeverity>
    <hediffClass>HediffWithComps</hediffClass>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-1.0</severityPerDay>
      </li>
    </comps>
    <stages>
      <li>
        <label>recovering (light)</label>
        <statFactors>
          <WorkSpeedGlobal>0.9</WorkSpeedGlobal>
        </statFactors>
      </li>
      <li>
        <minSeverity>0.33</minSeverity>
        <label>recovering</label>
        <statFactors>
          <WorkSpeedGlobal>0.75</WorkSpeedGlobal>
          <MoveSpeed>0.85</MoveSpeed>
        </statFactors>
      </li>
      <li>
        <minSeverity>0.66</minSeverity>
        <label>recovering (heavy)</label>
        <statFactors>
          <WorkSpeedGlobal>0.6</WorkSpeedGlobal>
          <MoveSpeed>0.7</MoveSpeed>
          <GlobalLearningFactor>0.5</GlobalLearningFactor>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

</Defs>
