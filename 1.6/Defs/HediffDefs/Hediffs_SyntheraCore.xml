<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <HediffDef>
    <defName>SyntheraConsciousness</defName>
    <label>synthera projection</label>
    <description>This consciousness has been projected as a synthera avatar.</description>
    <isBad>false</isBad>
    <stages>
      <li>
        <statFactors>
          <MoveSpeed>1.2</MoveSpeed>
          <WorkSpeedGlobal>1.1</WorkSpeedGlobal>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <!-- Applied by Need_SyntheraCoherence when buffer exceeds 75%; removed on recall/flush. -->
  <HediffDef>
    <defName>SyntheraCoherenceStrain</defName>
    <label>cache overflow strain</label>
    <description>The synthera avatar's processing buffer is filling dangerously. Accumulated data is causing contention across active subsystems, throttling performance as the system struggles to manage the overflow pressure. Recalling the avatar to its altar flushes the buffer cleanly and instantly resolves the strain.</description>
    <hediffClass>Hediff</hediffClass>
    <isBad>true</isBad>
    <defaultLabelColor>(1.0, 0.5, 0.1)</defaultLabelColor>
    <stages>
      <!-- Filling: 75–90% cache -->
      <li>
        <label>filling</label>
        <minSeverity>0</minSeverity>
        <statFactors>
          <WorkSpeedGlobal>0.9</WorkSpeedGlobal>
          <MoveSpeed>0.95</MoveSpeed>
        </statFactors>
      </li>
      <!-- Overflow imminent: above 90% cache -->
      <li>
        <label>overflow imminent</label>
        <minSeverity>0.5</minSeverity>
        <statFactors>
          <WorkSpeedGlobal>0.75</WorkSpeedGlobal>
          <MoveSpeed>0.85</MoveSpeed>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <!-- Applied after restoring a hibernating avatar from backup. Fades over 1 in-game day (24h). -->
  <HediffDef>
    <defName>SyntheraHibernationSyndrome</defName>
    <label>hibernation syndrome</label>
    <description>Deep system corruption from an abrupt cache crash. The avatar's projection collapsed before a clean cache release could occur, leaving corrupted data fragments that must be purged and reallocated. Cognitive and motor functions are impaired while the cache is rebuilt from scratch. Fully clears after 24 hours of active deployment.</description>
    <isBad>true</isBad>
    <maxSeverity>1.0</maxSeverity>
    <hediffClass>HediffWithComps</hediffClass>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-1.0</severityPerDay>
      </li>
    </comps>
    <stages>
      <li>
        <label>recovering (light)</label>
        <statFactors>
          <WorkSpeedGlobal>0.9</WorkSpeedGlobal>
        </statFactors>
      </li>
      <li>
        <minSeverity>0.33</minSeverity>
        <label>recovering</label>
        <statFactors>
          <WorkSpeedGlobal>0.75</WorkSpeedGlobal>
          <MoveSpeed>0.85</MoveSpeed>
        </statFactors>
      </li>
      <li>
        <minSeverity>0.66</minSeverity>
        <label>recovering (heavy)</label>
        <statFactors>
          <WorkSpeedGlobal>0.6</WorkSpeedGlobal>
          <MoveSpeed>0.7</MoveSpeed>
          <GlobalLearningFactor>0.5</GlobalLearningFactor>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

</Defs>
