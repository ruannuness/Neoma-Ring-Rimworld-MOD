<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Tier 1: Altar Básico -->
  <ThingDef ParentName="BuildingBase">
    <defName>NeomaAltarTier1</defName>
    <label>SyntheraCore_NeomaAltarTier1_Label</label>
    <description>SyntheraCore_NeomaAltarTier1_Description</description>
    <thingClass>Building</thingClass>
    <category>Building</category>
    <tickerType>Normal</tickerType>
    <graphicData>
      <texPath>Things/Building/Tier01/Tier01</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(5,5)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.4</fillPercent>
    <castEdgeShadows>true</castEdgeShadows>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <WorkToBuild>800</WorkToBuild>
      <Flammability>1.0</Flammability>
    </statBases>
    <costList>
      <Steel>100</Steel>
      <ComponentIndustrial>20</ComponentIndustrial>
      <Gold>50</Gold>
    </costList>
    <researchPrerequisites>
      <li>NeomaTier1</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
    <building>
      <isEdifice>false</isEdifice>
    </building>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>2000</basePowerConsumption>
      </li>
      <li Class="SyntheraCore.CompProperties_SyntheraSpawner">
        <pawnKind>NeomaPawnTier1</pawnKind>
        <spawnIntervalDays>0.08</spawnIntervalDays> <!-- ~2 horas -->
        <maxPawnsToSpawn>1</maxPawnsToSpawn>
        <spawnSound>Interact_Annihilator</spawnSound>
      </li>
      <li Class="CompProperties_HeatPusher">
        <compClass>CompHeatPusherPowered</compClass>
        <heatPerSecond>50</heatPerSecond>
      </li>
      <li Class="SyntheraCore.CompProperties_HeatRisk">
        <explosionDamage>50</explosionDamage>
        <explosionRadius>3</explosionRadius>
        <heatThreshold>40</heatThreshold>
        <explosionChancePerHour>0.1</explosionChancePerHour>
      </li>
    </comps>
    <size>(5,5)</size>
    <designationCategory>Neoma</designationCategory>
    <blueprintGraphicData>
      <texPath>Things/Building/Neoma/AltarTier1_blueprint</texPath>
    </blueprintGraphicData>
  </ThingDef>

