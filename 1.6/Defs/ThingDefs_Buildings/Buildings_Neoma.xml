  <!-- Cache Recharger: sustains nearby deployed Syntheras, slowing cache drain -->
  <ThingDef ParentName="BuildingBase">
    <defName>NeomaCoherenceRecharger</defName>
    <label>Cache Recharger</label>
    <description>A resonance emitter that projects a data-sustaining field over a small area. Synthera avatars within range restore cache more quickly, allowing longer continuous deployments. Essential for sustaining high-tier avatars indefinitely.</description>
    <thingClass>Building</thingClass>
    <category>Building</category>
    <tickerType>Normal</tickerType>
    <graphicData>
      <texPath>Things/Building/Tier02/Tier02</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>30</pathCost>
    <fillPercent>0.3</fillPercent>
    <castEdgeShadows>true</castEdgeShadows>
    <statBases>
      <MaxHitPoints>150</MaxHitPoints>
      <WorkToBuild>600</WorkToBuild>
      <Flammability>0.6</Flammability>
    </statBases>
    <costList>
      <Steel>80</Steel>
      <ComponentIndustrial>15</ComponentIndustrial>
      <Gold>30</Gold>
    </costList>
    <researchPrerequisites>
      <li>NeomaTierII</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
    <building>
      <isEdifice>false</isEdifice>
    </building>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>200</basePowerConsumption>
      </li>
      <li Class="SyntheraCore.CompProperties_SyntheraRecharger">
        <rechargePerInterval>0.001</rechargePerInterval>
        <radius>8</radius>
      </li>
    </comps>
    <size>(1,1)</size>
    <designationCategory>Neoma</designationCategory>
  </ThingDef>

