<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Holographic Stage — invoca a Virtual Diva (Miku).
    Texture: Textures/Things/Building/Miku/MikuStage.png  (Graphic_Single, drawSize 3x3)
    Requer pesquisa MikuStageResearch para construir.
  -->
  <ThingDef ParentName="BuildingBase">
    <defName>MikuHolographicStage</defName>
    <label>holographic stage</label>
    <description>A resonance platform that reconstructs the digital soul of a legendary virtual idol, projecting her as a fully-functional Synthera avatar. The stage emits a faint harmonic hum even when idle.</description>
    <thingClass>Building</thingClass>
    <category>Building</category>
    <tickerType>Normal</tickerType>
    <graphicData>
      <texPath>Things/Building/Miku/Hatsune</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(3,3)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.4</fillPercent>
    <castEdgeShadows>true</castEdgeShadows>
    <statBases>
      <MaxHitPoints>300</MaxHitPoints>
      <WorkToBuild>1200</WorkToBuild>
      <Flammability>0.5</Flammability>
      <Beauty>35</Beauty>
    </statBases>
    <costList>
      <Steel>200</Steel>
      <ComponentIndustrial>40</ComponentIndustrial>
      <Plasteel>60</Plasteel>
      <Gold>120</Gold>
      <SyntheraPersonaCore>2</SyntheraPersonaCore>
    </costList>
    <researchPrerequisites>
      <li>MikuStageResearch</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>7</constructionSkillPrerequisite>
    <building>
      <isEdifice>false</isEdifice>
    </building>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>900</basePowerConsumption>
      </li>
      <li Class="SyntheraCore.CompProperties_SyntheraSpawner">
        <pawnKind>NeomaPawnMiku</pawnKind>
        <spawnIntervalDays>1</spawnIntervalDays>
        <maxPawnsToSpawn>1</maxPawnsToSpawn>
        <spawnSound>MechanoidsWakeUp</spawnSound>
        <respawnTicks>60000</respawnTicks>
        <explosionRadius>2</explosionRadius>
        <maxAuxModules>3</maxAuxModules>
      </li>
      <li Class="CompProperties_HeatPusher">
        <compClass>CompHeatPusherPowered</compClass>
        <heatPerSecond>8</heatPerSecond>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="SyntheraCore.CompProperties_SwitchGraphic">
        <graphicPathOff>Things/Building/Miku/Hatsune_Off</graphicPathOff>
      </li>
      <li Class="CompProperties_Glower">
        <glowRadius>6</glowRadius>
        <glowColor>(30,140,255,0)</glowColor>
      </li>
    </comps>
    <size>(3,3)</size>
    <designationCategory>Neoma</designationCategory>
  </ThingDef>

</Defs>
