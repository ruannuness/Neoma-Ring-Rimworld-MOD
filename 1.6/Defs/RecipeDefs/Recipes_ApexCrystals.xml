    </modExtensions>
  </RecipeDef>

  <RecipeDef>
    <defName>AbsorbApexCrystal_III</defName>
    <label>absorb apex crystal III — transcendent</label>
    <description>Administer the Pure Synthetic Apex Crystal to the subject. The totality of archotech evolutionary potential compressed into a single moment of transcendence.</description>
    <workerClass>SyntheraCore.Recipe_AbsorbApexCrystal</workerClass>
    <jobString>absorbing apex crystal III</jobString>
    <workAmount>2000</workAmount>
    <surgerySuccessChanceFactor>99999</surgerySuccessChanceFactor>
    <researchPrerequisite>NeomaApex_III</researchPrerequisite>
    <recipeUsers>
      <li>Human</li>
      <li>SyntheraRaceTierI</li>
      <li>SyntheraRaceTierII</li>
      <li>SyntheraRaceTierIII</li>
      <li>SyntheraRaceTierIV</li>
      <li>SyntheraRaceMiku</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter><thingDefs><li>SyntheraApexCrystal_Pure</li></thingDefs></filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>SyntheraApexCrystal_Pure</li>
      </thingDefs>
    </fixedIngredientFilter>
    <appliedOnFixedBodyParts>
      <li>Brain</li>
    </appliedOnFixedBodyParts>
    <modExtensions>
      <li Class="SyntheraCore.ApexCrystalRecipeExtension">
        <apexLevelTarget>3</apexLevelTarget>
      </li>
    </modExtensions>
  </RecipeDef>

</Defs>
