  <!-- ─── Surgery / administration recipes for kits ─── -->

  <RecipeDef>
    <defName>Administer_NeomaKit_Repair</defName>
    <label>apply Neoma repair kit</label>
    <description>Inject Apex Crystal nano-agents to dissolve accumulated physical damage.</description>
    <jobString>Applying repair kit.</jobString>
    <workerClass>Recipe_Surgery</workerClass>
    <workAmount>600</workAmount>
    <workSkill>Medicine</workSkill>
    <isViolation>false</isViolation>
    <surgerySuccessChanceFactor>99999</surgerySuccessChanceFactor>
    <deathOnFailedSurgeryChance>0</deathOnFailedSurgeryChance>
    <addsHediff>NeomaRepairEffect</addsHediff>
    <appliedOnFixedBodyParts/>
    <ingredients>
      <li>
        <filter><thingDefs><li>NeomaKit_Repair</li></thingDefs></filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>NeomaKit_Repair</li>
      </thingDefs>
    </fixedIngredientFilter>
  </RecipeDef>

  <RecipeDef>
    <defName>Administer_NeomaKit_CachePurge</defName>
    <label>apply cache purge kit</label>
    <description>Deliver a targeted electromagnetic discharge to flush Synthera system stress.</description>
