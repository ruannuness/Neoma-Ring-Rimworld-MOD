<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ═══════════════════════════════════════════════════════════════
       APPAREL — gated behind NeomaRing_Calibration
       ═══════════════════════════════════════════════════════════════ -->

  <RecipeDef>
    <defName>NeomaMake_Synthsuit</defName>
    <label>craft Neoma synthsuit</label>
    <description>Synthesize an Apex Crystal exo-suit keyed to Neoma's biometric signature.</description>
    <jobString>Synthesizing Neoma synthsuit.</jobString>
    <workAmount>8000</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Crafting</workSkill>
    <workSkillLearnFactor>0.5</workSkillLearnFactor>
    <recipeUsers>
      <li>NeomaFabricationConsole</li>
    </recipeUsers>
    <researchPrerequisite>NeomaRing_Calibration</researchPrerequisite>
    <modExtensions>
      <li Class="SyntheraCore.NeomaCraftExtension"/>
    </modExtensions>
    <ingredients>
      <li>
        <filter><thingDefs><li>SyntheraApexCrystal_Basic</li></thingDefs></filter>
        <count>2</count>
      </li>
      <li>
        <filter><thingDefs><li>SyntheraArchotechShard</li></thingDefs></filter>
        <count>20</count>
      </li>
      <li>
        <filter><thingDefs><li>Plasteel</li></thingDefs></filter>
        <count>80</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>SyntheraApexCrystal_Basic</li>
        <li>SyntheraArchotechShard</li>
        <li>Plasteel</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <Apparel_NeomaSynthsuit>1</Apparel_NeomaSynthsuit>
    </products>
  </RecipeDef>

